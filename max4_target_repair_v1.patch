+def value_target_check(question, plan):
+    """Only detect a clear name/value request answered with a boolean root.
+
+    No work/person/date compatibility, relation, keyword coverage or punctuation
+    checks. Abstention is intentional. Compatible means no detected polarity
+    conflict, not a semantically correct tree. This does not change prompt hints
+    or the pre-existing, broader reviewer prechecks.
+    """
+    root = next(n for n in plan['nodes'] if n['id'] == plan['final'])
+    text = ' '.join(question.casefold().split())
+    mode = question_answer_mode(question)
+    target = answer_target(question)
+    ambiguous = bool(re.search(
+        r'\b(?:truth[ -]value|boolean|yes\s*/\s*no|true\s*/\s*false|'
+        r'yes or no|true or false|whether)\b', text))
+    # Bare "what/how" may ask for an explanation, a logical value, etc.
+    # Embedded explicit targets (e.g. "in what manga") are supported by the
+    # existing conservative extractor; unsupported forms abstain.
+    direct_wh = bool(re.match(r'^(?:who|whom|whose|which|where|when)\b', text))
+    clear_value = not ambiguous and (
+        (mode == 'value' and (direct_wh or target is not None)) or
+        (mode is None and target is not None))
+    root_mode = question_answer_mode(root['question'])
+    mismatch = clear_value and (root['answer_type'] == 'boolean' or root_mode == 'boolean')
+    errors = []
+    if mismatch:
+        errors.append(root['id'] + ': original question requests a name/value, but the final node '
+                      'has a boolean type or asks yes/no. Rewrite its question and type to return the '
+                      'requested name/value, preserving each entity with its property and all constraints.')
+    return {'status': 'mismatch' if mismatch else ('compatible' if clear_value else 'not_checked'),
+            'scope': 'clear_value_request_to_boolean_root_only',
+            'expected_mode': 'value' if clear_value else None,
+            'root_id': root['id'], 'root_answer_type': root['answer_type'],
+            'root_question_mode': root_mode, 'errors': errors}
+
+
 def semantic_precheck(question, plan):
     root = root_answer_check(question, plan)
     bindings = binding_errors(plan)
