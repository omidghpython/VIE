+"""Target-detector and shared-budget tests; no claim about live model accuracy."""
+import copy
+import csv
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+
+import decomposition_pilot as pilot
+from hotpotqa_operadic_rag.decomposition import (
+    PLAN_SYSTEM, TargetPlanError, DecompositionError, generate_plan,
+    decompose_question, value_target_check, plan_instructions,
+)
+from test_decomposition_pilot import ScriptedModel
+
+
+def single(question, kind):
+    return {'nodes': [{'id': 'q1', 'question': question,
+                      'dependencies': {}, 'answer_type': kind}], 'final': 'q1'}
+
+
+QUESTION = 'Which botanist discovered the fern, Talia or Ivo?'
+BAD = single('Did Talia discover the fern?', 'boolean')
+GOOD = {'nodes': [
+    {'id': 'q1', 'question': 'Did Talia discover the fern?', 'dependencies': {}, 'answer_type': 'boolean'},
+    {'id': 'q2', 'question': 'Did Ivo discover the fern?', 'dependencies': {}, 'answer_type': 'boolean'},
+    {'id': 'q3', 'question': 'Which botanist discovered the fern: Talia ({{q1}}) or Ivo ({{q2}})?',
+     'dependencies': {'q1': 'boolean', 'q2': 'boolean'}, 'answer_type': 'person'}], 'final': 'q3'}
+
+
+class Model:
+    plan_tokens = 3072
+    def __init__(self, *outputs):
+        self.outputs = list(outputs)
+        self.messages = []
+    def generate(self, messages, max_new_tokens=None):
+        self.messages.append(copy.deepcopy(messages))
+        reply = self.outputs.pop(0)
+        return reply if isinstance(reply, str) else json.dumps(reply)
+    def ask_json(self, prompt):
+        raise AssertionError('Unresolved target must not reach the judge.')
+
+
+class TargetDetectorTests(unittest.TestCase):
+    def test_synthetic_positive_cases_outside_evaluation_set(self):
+        questions = [QUESTION, 'Who designed the Zephyr monument?',
+                     'Where was the inventor of the Vela engine born?',
+                     'When was the Cobalt bridge opened?', 'What year did Selene graduate?',
+                     'How many towers does the Arin fortress have?',
+                     'The narrator of Vela appeared in what novel?',
+                     'Which statement is true about the new bridge?']
+        for question in questions:
+            with self.subTest(question=question):
+                self.assertEqual(value_target_check(question, BAD)['status'], 'mismatch')
+
+    def test_legitimate_boolean_and_uncertain_requests_are_not_rejected(self):
+        questions = ['Did Talia discover the fern?', 'Are the two rivers equally long?',
+                     'What is the truth value of the statement?',
+                     'What is the truth-value of the statement?',
+                     'What is the Boolean result of this expression?',
+                     'Which answer applies: yes/no?', 'What is the answer: true/false?',
+                     'What is the result of the test?',
+                     'Could you tell me which botanist discovered the fern?',
+                     'How can we tell whether the botanist discovered the fern?',
+                     'Explain the finding.', 'Choose the best option.']
+        for question in questions:
+            with self.subTest(question=question):
+                self.assertEqual(value_target_check(question, BAD)['status'], 'not_checked')
+
+    def test_boolean_intermediates_are_allowed_and_tree_not_mutated(self):
+        before = copy.deepcopy(GOOD)
+        self.assertEqual(value_target_check(QUESTION, GOOD)['status'], 'compatible')
+        self.assertEqual(GOOD, before)
+
+    def test_root_wording_and_type_are_checked_independently(self):
+        for plan in [single('Did Talia discover the fern?', 'person'),
+                     single('Which botanist discovered the fern?', 'boolean')]:
+            self.assertEqual(value_target_check(QUESTION, plan)['status'], 'mismatch')
+
+    def test_wrong_nonboolean_types_and_missing_question_mark_are_out_of_scope(self):
+        plan = single('Name the botanist who discovered the fern', 'work')
+        self.assertEqual(value_target_check(QUESTION, plan)['status'], 'compatible')
+        self.assertEqual(value_target_check('Did Talia discover it?', plan)['status'], 'not_checked')
+
+    def test_saved_outputs_match_narrow_assistant_labels_not_general_accuracy(self):
+        path = Path(__file__).resolve().parents[1] / 'evaluation/target_detector_saved_audit.json'
+        data = json.loads(path.read_text(encoding='utf-8'))
+        checked = positive = 0
+        for row in data['rows']:
+            if 'plan' not in row:
+                continue
+            actual = value_target_check(row['question'], row['plan'])['status'] == 'mismatch'
+            self.assertEqual(actual, row['expected_value_to_boolean_mismatch'], (row['run'], row['index']))
+            checked += 1
+            positive += actual
+        self.assertEqual((checked, positive), (75, 5))
