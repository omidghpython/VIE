+        self.assertEqual(plan, GOOD)
+        self.assertEqual([e['status'] for e in trace], ['valid', 'valid'])
+        self.assertEqual(trace[0]['generation_status'], 'target_mismatch')
+        self.assertEqual(trace[0]['raw_output'], raw)
+        for messages in model.messages:
+            self.assertEqual(messages[0]['content'], plan_instructions(QUESTION))
+            self.assertTrue(messages[1]['content'].startswith(QUESTION))
+        self.assertIn(raw, model.messages[1][1]['content'])
+        self.assertIn('preserving meaning and all constraints', model.messages[1][1]['content'])
+        self.assertIn('Rewrite its question and type', model.messages[1][1]['content'])
+
+    def test_repeated_target_failure_retains_plan_and_never_calls_judge(self):
+        model = Model(BAD, BAD)
+        with self.assertRaises(TargetPlanError) as cm:
+            decompose_question(model, QUESTION)
+        self.assertEqual(len(model.messages), 2)
+        self.assertEqual(cm.exception.details['structural_status'], 'valid')
+        self.assertEqual(cm.exception.details['semantic_status'], 'target_mismatch')
+        self.assertEqual(cm.exception.details['plan'], BAD)
