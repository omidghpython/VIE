+def target_display_phrase(question, target):
+    """Preserve a narrow coordinated role phrase for display only.
+
+    This is not coreference resolution: copying a phrase does not prove that its
+    roles name one individual. Repeated determiners, plural predicates, modifiers
+    and unfamiliar syntax fall back to the original head. Validator head/type
+    and the complete original question are untouched.
+    """
+    head = target['head']
+    if target['type'] != 'person' or head not in TARGET_WORDS['person'].split():
+        return head
+    text = ' '.join(question.casefold().split())
+    masked = re.sub(r'"[^"\n]*"', ' ', text)
+    wh = re.search(r'\b(?:what|which)\b', masked)
+    if not wh:
+        return head
+    roles = '|'.join(re.escape(word) for word in TARGET_WORDS['person'].split())
+    match = re.match(
+        r'\s*(?P<phrase>' + re.escape(head) + r'(?: and (?:' + roles + r'))+)'
+        r'(?=\s*(?:[?.!]|$)|\s+(?:is|was|has|does|did|who|that)\b)',
+        masked[wh.end():])
+    return match.group('phrase') if match else head
+
+
