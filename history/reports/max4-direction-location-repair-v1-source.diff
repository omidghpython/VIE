+LOCATION='Which facility was founded in Ontario, Alpha or Beta?'
+DIRECTION='The Vale is a traditional region southeast of a river that is how many km long?'
+BAD_LOCATION=tree(node('q1','When was Alpha founded?','date'),node('q2','When was Beta founded?','date'),
+                  node('q3','Which facility was founded in Ontario: Alpha (founded {{q1}}) or Beta (founded {{q2}})?','work',{'q1':'date','q2':'date'}))
+GOOD_LOCATION=tree(node('q1','Where was Alpha founded?','place'),node('q2','Where was Beta founded?','place'),
+                   node('q3','Which facility was founded in Ontario: Alpha ({{q1}}) or Beta ({{q2}})?','other',{'q1':'place','q2':'place'}))
+BAD_DIRECTION=tree(node('q1','Which river is southeast of the Vale?','other'),
+                   node('q2','How long is the river southeast of the Vale? ({{q1}}) in kilometers?','number',{'q1':'other'}))
+GOOD_DIRECTION=tree(node('q1','Which river is northwest of the Vale?','place'),
+                    node('q2','How long is {{q1}} in kilometers?','number',{'q1':'place'}))
+
+
+class Model:
+    plan_tokens=3072
+    last_raw_output=None
+    def __init__(self,replies): self.replies,self.messages=list(replies),[]
+    def generate(self,messages,**kwargs):
+        self.messages.append(copy.deepcopy(messages))
+        if telemetry._ACTIVE_TRACKER:
+            telemetry._ACTIVE_TRACKER.add_generate_invocation(10)
+        reply=self.replies.pop(0)
+        if isinstance(reply,BaseException):
+            self.last_raw_output=None
+            raise reply
+        if telemetry._ACTIVE_TRACKER: telemetry._ACTIVE_TRACKER.add_completion(5)
+        self.last_raw_output=reply if isinstance(reply,str) else json.dumps(reply)
+        return self.last_raw_output
+    def ask_json(self,prompt): return parse_json_object(self.generate([{'role':'user','content':prompt}]))
